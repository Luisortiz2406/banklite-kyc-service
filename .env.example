NODE_ENV=development
# Secretos: genera cada uno con node -e "console.log(require('crypto').randomBytes(32).toString('hex'))".
# El servicio no arranca si falta alguno, es corto o es un valor de ejemplo.
PORT=3003

# KYC DB (PostgreSQL)
DATABASE_URL=postgres://kyc_svc:<DB_PASSWORD_KYC>@localhost:5432/kyc_db

# Debe coincidir con el JWT_SECRET del Auth Service, ya que este
# microservicio valida los tokens emitidos por Auth para el endpoint
# protegido GET /kyc/:id_user.
JWT_SECRET=
STAFF_JWT_SECRET=
# AES-256 de los datos de identidad (64 caracteres hex). Obligatoria.
KYC_ENCRYPTION_KEY=

# Endpoints internos (GET /kyc/status, PATCH /kyc/contact): solo auth-service.
INTERNAL_TRUSTED_KEYS=auth:<clave-de-auth>

# RabbitMQ (publica identity.verified, consumido por Account Service)
RABBITMQ_URL=amqp://banklite:<RABBITMQ_PASSWORD>@localhost:5672
RABBITMQ_EXCHANGE=banklite.events

# Verifik — dos consultas: cédula (Registraduría) y antecedentes (Policía).
# demo aprueba sin consultar; live consulta Verifik (en live solo se acepta CC).
VERIFIK_MODE=demo
VERIFIK_API_KEY=
VERIFIK_API_URL=https://api.verifik.co/v2/co/cedula
# Si no se define, usa VERIFIK_MODE.
VERIFIK_ANTECEDENTES_MODE=
VERIFIK_ANTECEDENTES_URL=https://api.verifik.co/v2/co/policia/consultar
# jwt | Bearer (si Verifik responde 401, prueba el otro).
VERIFIK_AUTH_SCHEME=jwt
# true SOLO para el Sandbox de Verifik (nombres simulados). Nunca en producción.
VERIFIK_SKIP_NAME_CHECK=false

# Puerto de /metrics para Prometheus (solo red privada; no es el puerto público). "off" lo apaga.
METRICS_PORT=9100
